<%- include('.././layouts/layout', { body: `
<h1>My Projects</h1>
<a href="/projects/new">Create New Project</a>
<div class="projects-container">
  ${projects.map(project => `
  <div class="project-card">
    <h2>${project.title}</h2>
    <p>${project.summary}</p>
    <ul>
      ${project.tech.map(tech => `
      <li>${tech}</li>
      `).join('')}
    </ul>
    <img src="${project.screenshot}" alt="${project.title} screenshot" />
    <a href="/projects/${project._id}/edit">Edit</a>
    <form
      action="/projects/${project._id}/delete"
      method="POST"
      onsubmit="return confirm('Are you sure?')"
    >
      <button type="submit">Delete</button>
    </form>
  </div>
  `).join('')}
</div>
` }) %>
